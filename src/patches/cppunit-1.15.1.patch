--- cppunit-1.15.1/CMakeLists.txt	1970-01-01 04:00:00.000000000 +0400
+++ cppunit-1.15.1/CMakeLists.txt	2026-08-14 16:34:51.106389714 +0400
@@ -0,0 +1,113 @@
+cmake_minimum_required(VERSION 3.15)
+
+cmake_policy(SET CMP0091 NEW)
+
+project(cppunit LANGUAGES CXX)
+
+include(CTest)
+
+
+###############################################################################
+# CppUnit library
+###############################################################################
+
+file(GLOB CPPUNIT_SOURCES CONFIGURE_DEPENDS
+    "${CMAKE_CURRENT_SOURCE_DIR}/src/cppunit/*.cpp"
+)
+
+add_library(cppunit ${CPPUNIT_SOURCES})
+
+target_include_directories(cppunit
+    PUBLIC
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
+        $<INSTALL_INTERFACE:include>
+)
+
+if(BUILD_SHARED_LIBS)
+    target_compile_definitions(cppunit
+        PRIVATE CPPUNIT_BUILD_DLL
+        INTERFACE CPPUNIT_DLL
+    )
+endif()
+
+set_target_properties(cppunit PROPERTIES
+    DEBUG_POSTFIX d
+)
+
+
+###############################################################################
+# Tests
+###############################################################################
+
+if(BUILD_TESTING)
+    #
+    # Main CppUnit self-test suite
+    #
+    file(GLOB CPPUNIT_SELFTEST_SOURCES CONFIGURE_DEPENDS
+        "${CMAKE_CURRENT_SOURCE_DIR}/examples/cppunittest/*.cpp"
+    )
+
+    # This is a separate DLL test plug-in and must not be linked into
+    # cppunittestmain.
+    list(REMOVE_ITEM CPPUNIT_SELFTEST_SOURCES
+        "${CMAKE_CURRENT_SOURCE_DIR}/examples/cppunittest/CppUnitTestPlugIn.cpp"
+    )
+
+    add_executable(cppunittestmain
+        ${CPPUNIT_SELFTEST_SOURCES}
+    )
+
+    target_include_directories(cppunittestmain PRIVATE
+        "${CMAKE_CURRENT_SOURCE_DIR}/include"
+        "${CMAKE_CURRENT_SOURCE_DIR}/examples/cppunittest"
+    )
+
+    target_link_libraries(cppunittestmain PRIVATE
+        cppunit
+    )
+
+    add_test(
+        NAME cppunit-selftest
+        COMMAND $<TARGET_FILE:cppunittestmain>
+    )
+
+    #
+    # DllPlugInTester command-line parser tests
+    #
+    add_executable(DllPlugInTesterTest
+        src/DllPlugInTester/DllPlugInTesterTest.cpp
+        src/DllPlugInTester/CommandLineParser.cpp
+        src/DllPlugInTester/CommandLineParserTest.cpp
+    )
+
+    target_include_directories(DllPlugInTesterTest PRIVATE
+        "${CMAKE_CURRENT_SOURCE_DIR}/include"
+        "${CMAKE_CURRENT_SOURCE_DIR}/src/DllPlugInTester"
+    )
+
+    target_link_libraries(DllPlugInTesterTest PRIVATE
+        cppunit
+    )
+
+    add_test(
+        NAME cppunit-dll-plugin-tester
+        COMMAND $<TARGET_FILE:DllPlugInTesterTest>
+    )
+endif()
+
+
+###############################################################################
+# Install
+###############################################################################
+
+install(
+    TARGETS cppunit
+    RUNTIME DESTINATION bin
+    ARCHIVE DESTINATION lib
+    LIBRARY DESTINATION lib
+)
+
+install(
+    DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/include/cppunit"
+    DESTINATION include
+)
