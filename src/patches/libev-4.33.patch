--- libev-4.33/CMakeLists.txt	1970-01-01 04:00:00.000000000 +0400
+++ libev-4.33/CMakeLists.txt	2026-08-21 23:30:48.902380712 +0400
@@ -0,0 +1,94 @@
+cmake_minimum_required(VERSION 3.15)
+
+cmake_policy(SET CMP0091 NEW)
+
+project(libev
+    VERSION 4.33
+    LANGUAGES C
+)
+
+include(GNUInstallDirs)
+include(CTest)
+
+add_library(ev SHARED
+    ev.c
+)
+
+target_include_directories(ev
+    PUBLIC
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
+        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+)
+
+target_compile_definitions(ev
+    PUBLIC
+        EV_STANDALONE=1
+        FD_SETSIZE=1024
+    PRIVATE
+        EV_BUILDING_DLL=1
+        _CRT_SECURE_NO_WARNINGS
+)
+
+if(WIN32)
+    target_link_libraries(ev PRIVATE ws2_32)
+endif()
+
+set_target_properties(ev PROPERTIES
+    OUTPUT_NAME ev
+    PUBLIC_HEADER "ev.h;ev++.h"
+    MSVC_RUNTIME_LIBRARY
+        "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
+)
+
+install(
+    TARGETS ev
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    PUBLIC_HEADER DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+)
+
+if(BUILD_TESTING)
+    file(WRITE
+        "${CMAKE_CURRENT_BINARY_DIR}/libev-dll-test.c"
+        [=[
+#include <ev.h>
+
+int main(void)
+{
+    struct ev_loop *loop;
+
+    if (ev_version_major() != 4 ||
+        ev_version_minor() != 33) {
+        return 1;
+    }
+
+    loop = ev_default_loop(EVFLAG_AUTO);
+    if (loop == 0) {
+        return 2;
+    }
+
+    /*
+     * Accesses the imported global variable
+     * ev_default_loop_ptr.
+     */
+    if (EV_DEFAULT_UC != loop) {
+        return 3;
+    }
+
+    ev_loop_destroy(loop);
+    return 0;
+}
+]=])
+
+    add_executable(libev-dll-test
+        "${CMAKE_CURRENT_BINARY_DIR}/libev-dll-test.c"
+    )
+
+    target_link_libraries(libev-dll-test PRIVATE ev)
+
+    add_test(
+        NAME libev-dll
+        COMMAND libev-dll-test
+    )
+endif()
