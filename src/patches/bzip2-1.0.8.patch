diff -ur bzip2-1.0.8/Makefile bzip2-1.0.8/Makefile
--- bzip2-1.0.8/Makefile	2019-07-13 17:50:05.000000000 +0000
+++ bzip2-1.0.8/Makefile	2024-03-25 11:51:30.308393336 +0000
@@ -12,21 +12,32 @@
 # in the file LICENSE.
 # ------------------------------------------------------------------
 
-SHELL=/bin/sh
-
-# To assist in cross-compiling
-CC=gcc
-AR=ar
-RANLIB=ranlib
-LDFLAGS=
-
-BIGFILES=-D_FILE_OFFSET_BITS=64
-CFLAGS=-Wall -Winline -O2 -g $(BIGFILES)
+SHELL ?= /bin/bash
+CC ?= gcc
+AR ?= ar
+RANLIB ?= ranlib
+
+BIGFILES = -D_FILE_OFFSET_BITS=64
+CFLAGS += -Wall -Winline $(BIGFILES) -I.
+LDFLAGS += -L.
+
+VERSION = 1.0.8
+SOBASE  = libbz2.so
+SOMAJOR = 1
+SOFILE  = $(SOBASE).$(VERSION)
+SONAME  = $(SOBASE).$(SOMAJOR)
+
+UNAME?= $(shell uname)
+
+ifeq ($(UNAME), AIX)
+	SOFLAGS = -shared -Wl,-G
+else
+	SOFLAGS = -shared -Wl,-soname,$(SONAME)
+endif
 
 # Where you want it installed when you do 'make install'
 PREFIX=/usr/local
 
-
 OBJS= blocksort.o  \
       huffman.o    \
       crctable.o   \
@@ -35,22 +46,19 @@
       decompress.o \
       bzlib.o
 
-all: libbz2.a bzip2 bzip2recover test
+all: $(SOFILE) bzip2 bzip2recover
 
-bzip2: libbz2.a bzip2.o
-	$(CC) $(CFLAGS) $(LDFLAGS) -o bzip2 bzip2.o -L. -lbz2
+bzip2: $(SOFILE)
+	$(CC) $(CFLAGS) $(LDFLAGS) -o bzip2 bzip2.c -lbz2
 
 bzip2recover: bzip2recover.o
 	$(CC) $(CFLAGS) $(LDFLAGS) -o bzip2recover bzip2recover.o
 
-libbz2.a: $(OBJS)
-	rm -f libbz2.a
-	$(AR) cq libbz2.a $(OBJS)
-	@if ( test -f $(RANLIB) -o -f /usr/bin/ranlib -o \
-		-f /bin/ranlib -o -f /usr/ccs/bin/ranlib ) ; then \
-		echo $(RANLIB) libbz2.a ; \
-		$(RANLIB) libbz2.a ; \
-	fi
+$(SOFILE): $(OBJS)
+	rm -f $(SOFILE) $(SONAME) $(SOBASE)
+	$(CC) $(CFLAGS) $(LDFLAGS) $(SOFLAGS) -o $(SOFILE) $(OBJS)
+	ln -s $(SOFILE) $(SONAME)
+	ln -s $(SOFILE) $(SOBASE)
 
 check: test
 test: bzip2
@@ -87,17 +95,19 @@
 	chmod a+r $(PREFIX)/man/man1/bzip2.1
 	cp -f bzlib.h $(PREFIX)/include
 	chmod a+r $(PREFIX)/include/bzlib.h
-	cp -f libbz2.a $(PREFIX)/lib
-	chmod a+r $(PREFIX)/lib/libbz2.a
+	cp -f $(SOFILE) $(PREFIX)/lib
+	chmod a+r $(PREFIX)/lib/$(SOFILE)
+	ln -s -f $(SOFILE) $(PREFIX)/lib/$(SONAME)
+	ln -s -f $(SOFILE) $(PREFIX)/lib/$(SOBASE)
 	cp -f bzgrep $(PREFIX)/bin/bzgrep
-	ln -s -f $(PREFIX)/bin/bzgrep $(PREFIX)/bin/bzegrep
-	ln -s -f $(PREFIX)/bin/bzgrep $(PREFIX)/bin/bzfgrep
+	ln -s -f bzgrep $(PREFIX)/bin/bzegrep
+	ln -s -f bzgrep $(PREFIX)/bin/bzfgrep
 	chmod a+x $(PREFIX)/bin/bzgrep
 	cp -f bzmore $(PREFIX)/bin/bzmore
-	ln -s -f $(PREFIX)/bin/bzmore $(PREFIX)/bin/bzless
+	ln -s -f bzmore $(PREFIX)/bin/bzless
 	chmod a+x $(PREFIX)/bin/bzmore
 	cp -f bzdiff $(PREFIX)/bin/bzdiff
-	ln -s -f $(PREFIX)/bin/bzdiff $(PREFIX)/bin/bzcmp
+	ln -s -f bzdiff $(PREFIX)/bin/bzcmp
 	chmod a+x $(PREFIX)/bin/bzdiff
 	cp -f bzgrep.1 bzmore.1 bzdiff.1 $(PREFIX)/man/man1
 	chmod a+r $(PREFIX)/man/man1/bzgrep.1
@@ -110,6 +120,7 @@
 
 clean: 
 	rm -f *.o libbz2.a bzip2 bzip2recover \
+	$(SOFILE) $(SONAME) $(SOBASE) \
 	sample1.rb2 sample2.rb2 sample3.rb2 \
 	sample1.tst sample2.tst sample3.tst
 
@@ -128,16 +139,13 @@
 	$(CC) $(CFLAGS) -c decompress.c
 bzlib.o: bzlib.c
 	$(CC) $(CFLAGS) -c bzlib.c
-bzip2.o: bzip2.c
-	$(CC) $(CFLAGS) -c bzip2.c
 bzip2recover.o: bzip2recover.c
 	$(CC) $(CFLAGS) -c bzip2recover.c
 
-
 distclean: clean
 	rm -f manual.ps manual.html manual.pdf
 
-DISTNAME=bzip2-1.0.8
+DISTNAME=bzip2-$(VERSION)
 dist: check manual
 	rm -f $(DISTNAME)
 	ln -s -f . $(DISTNAME)
