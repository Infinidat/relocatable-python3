+CFLAGS=/DWIN32 /MD /Ox /D_FILE_OFFSET_BITS=64 /nologo
+
+DLL=bz2.dll
+IMPLIB=bz2.lib
+
+!IFNDEF PREFIX
+PREFIX=dist
+!ENDIF
+
+OBJS=blocksort.obj  \
+     huffman.obj    \
+     crctable.obj   \
+     randtable.obj  \
+     compress.obj   \
+     decompress.obj \
+     bzlib.obj
+
+all: $(DLL) bzip2.exe bzip2recover.exe
+
+lib: $(DLL)
+
+$(DLL): $(OBJS) libbz2.def
+	$(LD) /nologo /DLL /OUT:$(DLL) /IMPLIB:$(IMPLIB) /DEF:libbz2.def $(OBJS)
+
+bzip2.exe: $(DLL) bzip2.c
+	$(CC) $(CFLAGS) /Fe:bzip2.exe bzip2.c $(IMPLIB) setargv.obj
+
+bzip2recover.exe: bzip2recover.c
+	$(CC) $(CFLAGS) /Fe:bzip2recover.exe bzip2recover.c
+
+test: bzip2.exe
+	@type words1
+	.\bzip2.exe -1  < sample1.ref > sample1.rb2
+	.\bzip2.exe -2  < sample2.ref > sample2.rb2
+	.\bzip2.exe -3  < sample3.ref > sample3.rb2
+	.\bzip2.exe -d  < sample1.bz2 > sample1.tst
+	.\bzip2.exe -d  < sample2.bz2 > sample2.tst
+	.\bzip2.exe -ds < sample3.bz2 > sample3.tst
+	@echo All six fc commands should find no differences.
+	fc sample1.bz2 sample1.rb2
 	fc sample2.bz2 sample2.rb2
 	fc sample3.bz2 sample3.rb2
 	fc sample1.tst sample1.ref
 	fc sample2.tst sample2.ref
 	fc sample3.tst sample3.ref
 
+install: $(DLL)
+	if not exist "$(PREFIX)\bin" mkdir "$(PREFIX)\bin"
+	if not exist "$(PREFIX)\lib" mkdir "$(PREFIX)\lib"
+	if not exist "$(PREFIX)\include" mkdir "$(PREFIX)\include"
+	copy /B /V /Y "$(DLL)" "$(PREFIX)\bin\$(DLL)"
+	copy /B /V /Y "$(IMPLIB)" "$(PREFIX)\lib\$(IMPLIB)"
+	copy /B /V /Y bzlib.h "$(PREFIX)\include\bzlib.h"
+
+clean:
+	-del /Q $(OBJS) 2>NUL
+	-del /Q bzip2.obj bzip2recover.obj 2>NUL
+	-del /Q $(DLL) $(IMPLIB) bz2.exp 2>NUL
+	-del /Q bzip2.exe bzip2recover.exe 2>NUL
+	-del /Q sample1.rb2 sample2.rb2 sample3.rb2 2>NUL
+	-del /Q sample1.tst sample2.tst sample3.tst 2>NUL
 
