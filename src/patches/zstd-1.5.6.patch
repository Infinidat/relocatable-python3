diff -ur zstd-1.5.6/Makefile zstd-1.5.6/Makefile
--- zstd-1.5.6/Makefile	2024-03-21 22:05:51.000000000 +0000
+++ zstd-1.5.6/Makefile	2025-12-05 13:40:29.328650615 +0000
@@ -151,7 +151,7 @@
 #------------------------------------------------------------------------------
 # make install is validated only for Linux, macOS, Hurd and some BSD targets
 #------------------------------------------------------------------------------
-ifneq (,$(filter $(shell uname),Linux Darwin GNU/kFreeBSD GNU OpenBSD FreeBSD DragonFly NetBSD MSYS_NT CYGWIN_NT Haiku AIX))
+ifneq (,$(filter $(shell uname),Linux Darwin GNU/kFreeBSD GNU OpenBSD FreeBSD DragonFly NetBSD MSYS_NT CYGWIN_NT Haiku SunOS AIX))
 
 HOST_OS = POSIX
 
diff -ur zstd-1.5.6/lib/Makefile zstd-1.5.6/lib/Makefile
--- zstd-1.5.6/lib/Makefile	2024-03-21 22:05:51.000000000 +0000
+++ zstd-1.5.6/lib/Makefile	2025-12-05 13:40:29.328650615 +0000
@@ -140,7 +140,7 @@
 LIBZSTD = libzstd.$(SHARED_EXT_VER)
 .PHONY: $(LIBZSTD)  # must be run every time
 $(LIBZSTD): CPPFLAGS += $(CPPFLAGS_DYNLIB)
-$(LIBZSTD): CFLAGS   += -fPIC -fvisibility=hidden
+$(LIBZSTD): CFLAGS   += -fPIC
 $(LIBZSTD): LDFLAGS  += -shared $(LDFLAGS_DYNLIB)
 
 ifndef BUILD_DIR
@@ -239,7 +239,7 @@
 # but they will correctly behave single-threaded.
 ZSTDMT_FILES = zstdmt_compress.c
 ZSTD_NOMT_FILES = $(filter-out $(ZSTDMT_FILES),$(notdir $(ZSTD_FILES)))
-libzstd-nomt: CFLAGS += -fPIC -fvisibility=hidden
+libzstd-nomt: CFLAGS += -fPIC
 libzstd-nomt: LDFLAGS += -shared
 libzstd-nomt: $(ZSTD_NOMT_FILES)
 	@echo compiling single-thread dynamic library $(LIBVER)
@@ -320,7 +320,7 @@
 	        $< >$@
 
 .PHONY: install
-install: install-pc install-static install-shared install-includes
+install: install-pc install-shared install-includes
 	@echo zstd static and shared library installed
 
 .PHONY: install-pc
