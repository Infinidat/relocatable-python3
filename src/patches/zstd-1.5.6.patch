diff -ur zstd-1.5.6/tests/playTests.sh zstd-1.5.6/tests/playTests.sh
--- zstd-1.5.6/tests/playTests.sh	2024-03-21 22:05:51.000000000 +0000
+++ zstd-1.5.6/tests/playTests.sh	2025-12-05 13:40:29.329650620 +0000
@@ -1,4 +1,4 @@
-#!/bin/sh
+#!/bin/bash
 
 set -e # exit immediately on error
 # set -x # print commands before execution (debug)
@@ -94,11 +94,7 @@
 TESTDIR="$SCRIPT_DIR/../tests"
 UNAME=${UNAME:-$(uname)}
 GREP=${GREP:-grep}
-
-case "$UNAME" in
-  SunOS) DIFF=${DIFF:-gdiff} ;;
-  *) DIFF=${DIFF:-diff} ;;
-esac
+DIFF=${DIFF:-diff}
 
 detectedTerminal=false
 if [ -t 0 ] && [ -t 1 ]
@@ -330,7 +326,7 @@
 zstd -d -f tmp_corrupt.zst --check --no-check # final flag overrides
 zstd -d -f tmp.zst --no-check
 
-if [ "$isWindows" = false ] && [ "$UNAME" != "AIX" ]; then
+if [ "$isWindows" = false ] && [ "$UNAME" != "AIX" ] && [ "$UNAME" != "SunOS" ]; then
   if [ -n "$(which readelf)" ]; then
     println "test: check if binary has executable stack (#2963)"
     readelf -lW "$ZSTD_BIN" | $GREP 'GNU_STACK .* RW ' || die "zstd binary has executable stack!"
