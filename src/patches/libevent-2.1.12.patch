--- libevent-2.1.12-stable/CMakeLists.txt	2020-07-05 15:01:34.000000000 +0300
+++ libevent-2.1.12-stable/CMakeLists.txt	2026-01-27 20:08:23.565314100 +0200
@@ -19,7 +19,7 @@
 #       start libevent.sln
 #
 
-cmake_minimum_required(VERSION 3.1 FATAL_ERROR)
+cmake_minimum_required(VERSION 4.0 FATAL_ERROR)
 
 if (POLICY CMP0054)
     cmake_policy(SET CMP0054 NEW)
@@ -845,6 +845,8 @@
 
     set(EVENT__HAVE_OPENSSL 1)
 
+    list(APPEND OPENSSL_LIBRARIES Crypt32)
+
     message(STATUS "OpenSSL include: ${OPENSSL_INCLUDE_DIR}")
     message(STATUS "OpenSSL lib: ${OPENSSL_LIBRARIES}")
 
@@ -1078,16 +1080,34 @@
     #
     if (NOT EVENT__DISABLE_REGRESS)
         # (We require python to generate the regress tests)
-        find_package(PythonInterp 3)
 
-        if (PYTHONINTERP_FOUND)
+        set(__FOUND_USABLE_PYTHON 0)
+
+        # If caller already provided an interpreter, use it.
+        if (PYTHON_EXECUTABLE)
             set(__FOUND_USABLE_PYTHON 1)
         else()
-            find_package(PythonInterp 2)
-            if (PYTHONINTERP_FOUND)
-                set(__FOUND_USABLE_PYTHON 1)
-            else()
-                message(ERROR "No suitable Python version found, bailing...")
+            # Prefer modern CMake Python modules (avoids issues with CMP0148 / removed FindPythonInterp).
+            # FindPython3 was introduced in newer CMake; keep a fallback for older ones.
+            if (CMAKE_VERSION VERSION_GREATER_EQUAL "3.12")
+                find_package(Python3 COMPONENTS Interpreter QUIET)
+                if (Python3_FOUND)
+                    set(PYTHON_EXECUTABLE "${Python3_EXECUTABLE}")
+                    set(__FOUND_USABLE_PYTHON 1)
+                endif()
+            endif()
+
+            # Fallback for older CMake versions / environments.
+            if (NOT __FOUND_USABLE_PYTHON)
+                find_package(PythonInterp 3 QUIET)
+                if (PYTHONINTERP_FOUND)
+                    set(__FOUND_USABLE_PYTHON 1)
+                else()
+                    find_package(PythonInterp 2 QUIET)
+                    if (PYTHONINTERP_FOUND)
+                        set(__FOUND_USABLE_PYTHON 1)
+                    endif()
+                endif()
             endif()
         endif()
 
