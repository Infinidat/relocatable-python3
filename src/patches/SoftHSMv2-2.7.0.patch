+AC_DEFUN([ACX_SQLITE3], [
+        AC_ARG_WITH(
+                [sqlite3],
+                [AS_HELP_STRING(
+                        [--with-sqlite3=PATH],
+                        [Specify the SQLite3 installation prefix]
+                )],
+                [sqlite3_prefix="$withval"],
+                [sqlite3_prefix=no]
+        )
+
+        PKG_PROG_PKG_CONFIG
+
+        if test "x$sqlite3_prefix" = xno; then
+                if test "x${build_migrate}" = xyes -o \
+                        "x${build_objectstore_backend_db}" = xyes; then
+                        AC_MSG_ERROR([--with-sqlite3=PATH is required for the migration tool or database backend])
+                fi
+
+                SQLITE3_CFLAGS=""
+                SQLITE3_LIBS=""
+
+                AC_DEFINE(
+                        [HAVE_SQLITE3_H],
+                        [0],
+                        [Define to 1 if sqlite3.h is available]
+                )
+
+                AC_DEFINE(
+                        [HAVE_LIBSQLITE3],
+                        [0],
+                        [Define to 1 if the SQLite3 library is available]
+                )
+
+                AC_MSG_NOTICE([SQLite3 support disabled])
+        else
+                if test "x$sqlite3_prefix" = xyes -o \
+                        -z "$sqlite3_prefix"; then
+                        AC_MSG_ERROR([--with-sqlite3 requires an installation prefix])
+                fi
+
+                sqlite3_pkgconfig_path="$sqlite3_prefix/lib/pkgconfig"
+
+                if test ! -f "$sqlite3_pkgconfig_path/sqlite3.pc"; then
+                        AC_MSG_ERROR([Cannot find $sqlite3_pkgconfig_path/sqlite3.pc])
+                fi
+
+                PKG_CONFIG_PATH="$sqlite3_pkgconfig_path${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
+                export PKG_CONFIG_PATH
+
+                PKG_CHECK_MODULES_STATIC(
+                        [SQLITE3],
+                        [sqlite3 >= 3.4.2],
+                        [
+                                AC_DEFINE(
+                                        [HAVE_SQLITE3_H],
+                                        [1],
+                                        [Define to 1 if sqlite3.h is available]
+                                )
+
+                                AC_DEFINE(
+                                        [HAVE_LIBSQLITE3],
+                                        [1],
+                                        [Define to 1 if the SQLite3 library is available]
+                                )
+                        ],
+                        [
+                                AC_MSG_ERROR([SQLite3 3.4.2 or newer was not found using pkg-config])
+                        ]
+                )
+        fi
+
+        AC_SUBST([SQLITE3_CFLAGS])
+        AC_SUBST([SQLITE3_LIBS])
 ])
