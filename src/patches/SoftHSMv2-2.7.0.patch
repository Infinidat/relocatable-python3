-	CPPFLAGS="$CPPFLAGS $SQLITE3_INCLUDES"
-	LIBS="$LIBS $SQLITE3_LIBS"
-
-	AC_CHECK_HEADERS(sqlite3.h,,[AC_MSG_ERROR([Can't find SQLite3 headers])])
