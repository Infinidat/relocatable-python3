+/* GCC represents a single-field AIX aggregate such as
+   struct { float x; } using the scalar field mode.  The aggregate itself is
+   passed in the parameter save area/GPRs, but GCC still advances the FPR
+   argument index.  Return the number of FPRs reserved by such an aggregate.  */
+static unsigned
+aix_scalar_aggregate_fprs (ffi_type *type)
+{
+  ffi_type *element;
+
+  if (type->type != FFI_TYPE_STRUCT
+      || type->elements == NULL
+      || type->elements[0] == NULL
+      || type->elements[1] != NULL)
+    return 0;
+
+  element = type->elements[0];
+  if (type->size != element->size)
+    return 0;
+
+  if (element->type == FFI_TYPE_STRUCT)
+    return aix_scalar_aggregate_fprs (element);
+
+  switch (element->type)
+    {
+    case FFI_TYPE_FLOAT:
+    case FFI_TYPE_DOUBLE:
+      return 1;
+#if FFI_TYPE_LONGDOUBLE != FFI_TYPE_DOUBLE
+    case FFI_TYPE_LONGDOUBLE:
+      return 2;
+#endif
+    default:
+      return 0;
+    }
+}
+#endif
